# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# University announcements page URL (optional; /duyurular returns empty if unset)
UNIVERSITY_ANNOUNCEMENTS_URL=https://www.ktun.edu.tr/tr/Birim/Index/?brm=YlNTVXpJWnBCMHpLQlRaMnZFTXlMdz09

# Turso/libSQL database.
# Local file (default): file:./data/ktunbot.db
# Remote Turso:        libsql://<db>.turso.io  (also set TURSO_AUTH_TOKEN)
TURSO_DATABASE_URL=file:./data/ktunbot.db
TURSO_AUTH_TOKEN=

# Logging (tracing env-filter)
RUST_LOG=ktunbot=info,teloxide=warn,reqwest=warn